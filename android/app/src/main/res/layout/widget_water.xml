<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_water_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- Header bar with icon and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_water_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_water_header"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_water_target_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="الهدف: 3000 مل"
            android:textColor="#A0AEC0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Water Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_water_amount_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 / 3000 مل"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_water_percent_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Interactive Quick-Add Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <!-- +250 ml (One Cup) -->
        <Button
            android:id="@+id/widget_water_btn_add250"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_button_blue"
            android:text="@string/widget_water_add_250"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- +500 ml (Bottle) -->
        <Button
            android:id="@+id/widget_water_btn_add500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_button_blue"
            android:text="@string/widget_water_add_500"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- -250 ml (Undo) -->
        <Button
            android:id="@+id/widget_water_btn_sub250"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_widget_button"
            android:text="@string/widget_water_sub_250"
            android:textColor="#A0AEC0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
